// Rule language. See docs/rule-functions-spec.md.

?start: step_expr
      | expr

// Steps: a, b, c
step_expr: expr ("," expr)+               -> step_

// A pipe binds loosest: `a & b -> f(...)` filters on `a & b`, then calls f.
?expr: bool_expr
     | bool_expr ("->" call)+             -> pipe_

// A chain is all-or or all-and; mixing needs brackets: [a | b] & c
?bool_expr: or_expr
          | and_expr
          | atom

or_expr: atom ("|" atom)+                 -> or_
and_expr: atom ("&" atom)+                -> and_

?atom: call
     | literal
     | "[" expr "]"                       -> group
     | "[" step_expr "]"                  -> group
     | "(" expr ")"                       -> group
     | "(" step_expr ")"                  -> group

// Positional arguments first, then keyword arguments.
call: IDENT "(" [arg ("," arg)*] ")"      -> call

?arg: value
    | IDENT "=" value                     -> kwarg

?value: list_lit
      | expr
      | OP                                -> op

// list literal as a VALUE (requires at least one comma)
list_lit: "[" expr ("," expr)+ "]"        -> step_

?literal: name_ref
        | NUMBER                          -> number
        | STRING                          -> string

name_ref: IDENT                           -> simple_name
        | IDENT "@" IDENT                 -> qualified_name
        | BTICK_NAME                      -> quoted_name
        | IDENT "@" BTICK_NAME            -> quoted_name
        | "@" IDENT                       -> alias_name
        | "@" BTICK_NAME                  -> quoted_alias_name

OP: ">=" | "<=" | "==" | "!=" | ">" | "<"
IDENT: /[A-Za-z0-9_\-\.:;]+/
BTICK_NAME: /`([^`\\]|\\.)*`/
NUMBER: /[0-9]+(\.[0-9]+)?/
STRING: ESCAPED_STRING

%import common.ESCAPED_STRING
%import common.WS
%ignore WS
